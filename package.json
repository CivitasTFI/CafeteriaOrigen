{
  "name": "cafeteria-origen",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "install:all": "pnpm install",
    "dev:backend": "pnpm --dir backend dev",
    "dev:frontend": "pnpm --dir frontend dev",
    "test": "pnpm run test:backend && pnpm run test:frontend",
    "test:backend": "pnpm --dir backend exec jest --runInBand",
    "test:frontend": "pnpm --dir frontend exec vitest run",
    "test:watch:backend": "pnpm --dir backend exec jest --watch",
    "test:watch:frontend": "pnpm --dir frontend exec vitest",
    "build": "pnpm run build:backend && pnpm run build:frontend",
    "build:backend": "pnpm --dir backend build",
    "build:frontend": "pnpm --dir frontend build",
    "lint": "pnpm --dir frontend lint"
  }
}
